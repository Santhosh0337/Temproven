# ── FalkorDB connection ───────────────────────────────────────────────────────
# For local Docker:  FALKORDB_HOST=localhost, FALKORDB_PORT=6379, leave USERNAME/PASSWORD blank, SSL=false
# For FalkorDB Cloud: fill in the host/port from the cloud dashboard, set SSL=true

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false

# ── Graph names ───────────────────────────────────────────────────────────────
# The demo graph (seeded data lives here)
FALKORDB_GRAPH=temproven

# Tests create throwaway graphs named  temproven_test_<uuid>  and delete them
# afterwards. They never touch FALKORDB_GRAPH. No config needed here.
